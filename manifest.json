{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Faixa",
  "description": "__MSG_extDescription__",
  "version": "0.9.0",
  "default_locale": "pt_BR",
  "author": "Bluecker",
  "browser_specific_settings": {
    "gecko": {
      "id": "faixa@bluecker.com",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "32": "icons/faixa.svg",
    "64": "icons/faixa.svg"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "permissions": [
    "compose",
    "storage"
  ],
  "options_ui": {
    "page": "options/opcoes.html",
    "open_in_tab": true
  },
  "experiment_apis": {
    "faixa": {
      "schema": "experiments/faixa/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "faixa"
          ]
        ],
        "script": "experiments/faixa/implementation.js",
        "events": [
          "startup"
        ]
      }
    }
  }
}
