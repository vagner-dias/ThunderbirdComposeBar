    "toggleTbToolbar": { "label": "Mostrar a barra do Thunderbird", "pressed": "tbToolbar", "hidden": true },
    "toggleMenubar": { "label": "Mostrar a barra de menus", "pressed": "menubar", "hidden": true },
    "openDiagnostics": { "label": "Diagnóstico da Faixa", "icon": "stethoscope", "tip": "Autoteste da faixa, atalhos, fontes e a configuração em uso. Use “Copiar relatório” para mandar ao suporte." },
    "saveDraft": { "label": "Salvar Rascunho", "native": "cmd_saveDefault", "tbKeys": ["Ctrl+S"], "hidden": true },
