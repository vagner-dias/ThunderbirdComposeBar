    "saveAsDraft": { "label": "Salvar Rascunho", "icon": "save", "native": "cmd_saveAsDraft", "tbKeys": ["Ctrl+S"], "sameAs": "saveDraft", "hidden": true },
    "saveAsTemplate": { "label": "Salvar como Modelo", "icon": "file-text", "native": "cmd_saveAsTemplate", "hidden": true },
    "saveAsFile": { "label": "Salvar como Arquivo…", "native": "cmd_saveAsFile", "hidden": true },
    "print": { "label": "Imprimir…", "icon": "printer", "native": "cmd_print", "tbKeys": ["Ctrl+P"], "hidden": true },
    "properties": { "label": "Propriedades…", "phase": 2, "hidden": true },
    "ribbonOptions": { "label": "Opções da Faixa…", "icon": "settings", "tip": "Idioma, aba inicial, fonte padrão, Enter como no Outlook e perfil de atalhos." },
    "close": { "label": "Fechar", "icon": "x", "native": "cmd_close", "tbKeys": ["Ctrl+W"], "hidden": true },
