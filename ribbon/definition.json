    "attachPage": { "label": "Página da Web…", "icon": "globe", "native": "cmd_attachPage", "hidden": true },
    "attachCloud": { "label": "Filelink", "icon": "cloud-upload", "hidden": true },
    "attachVCard": { "label": "Meu Cartão de Visita (vCard)", "icon": "id-card", "hidden": true },
    "attachPublicKey": { "label": "Minha Chave Pública OpenPGP", "icon": "key-round", "hidden": true },
    "mergeFormatting": { "label": "Mesclar Formatação", "phase": 2, "hidden": true }
  },

  "fileTab": { "label": "Arquivo", "menu": "file", "tip": "Salvar, imprimir, opções da faixa e fechar a mensagem." },
  "qat": ["save", "undo", "redo"],

  "tabs": [
    {
      "id": "mensagem",
      "label": "Mensagem",
      "collapseOrder": ["tracking", "tags", "names", "include", "clipboard", "basicText"],
      "groups": [
        {
          "id": "clipboard", "label": "Área de Transferência", "icon": "clipboard-paste",
          "items": [
            { "type": "largeSplit", "cmd": "paste", "menu": "paste" },
            { "type": "stack", "items": [
              { "type": "small", "cmd": "cut" },
              { "type": "small", "cmd": "copy" },
              { "type": "small", "cmd": "painter" }
            ] }
          ]
        },
        {
          "id": "basicText", "label": "Texto Básico", "icon": "type",
          "items": [
            { "type": "rows", "rows": [
              [ { "type": "fontCombo", "cmd": "fontName" }, { "type": "sizeCombo", "cmd": "fontSize" }, { "type": "icon", "cmd": "growFont" }, { "type": "icon", "cmd": "shrinkFont" }, { "type": "sep" },
                { "type": "iconSplit", "cmd": "bullets" }, { "type": "iconSplit", "cmd": "numbering" }, { "type": "icon", "cmd": "outdent" }, { "type": "icon", "cmd": "indent" } ],
              [ { "type": "icon", "cmd": "bold" }, { "type": "icon", "cmd": "italic" }, { "type": "icon", "cmd": "underline" }, { "type": "sep" },
                { "type": "color", "cmd": "hilite" }, { "type": "color", "cmd": "foreColor" }, { "type": "sep" },
                { "type": "icon", "cmd": "alignLeft" }, { "type": "icon", "cmd": "alignCenter" }, { "type": "icon", "cmd": "alignRight" }, { "type": "sep" },
                { "type": "icon", "cmd": "clearFormatting" } ]
            ] }
          ]
        },
        {
          "id": "names", "label": "Nomes", "icon": "book-user",
          "items": [
            { "type": "large", "cmd": "addressBook" },
            { "type": "large", "cmd": "checkNames" }
          ]
        },
        {
          "id": "include", "label": "Incluir", "icon": "paperclip",
          "items": [
            { "type": "largeSplit", "cmd": "attachFile", "menu": "attach" },
            { "type": "stack", "items": [
              { "type": "small", "cmd": "insertLink" },
              { "type": "small", "cmd": "insertImage" },
              { "type": "smallMenu", "cmd": "signature" }
            ] }
          ]
        },
        {
          "id": "tags", "label": "Marcas", "icon": "flag",
          "items": [
            { "type": "largeSplit", "cmd": "followUp", "menu": "followUp" },
            { "type": "stack", "items": [
              { "type": "small", "cmd": "priorityHigh" },
              { "type": "small", "cmd": "priorityLow" }
            ] }
          ]
        },
        {
          "id": "tracking", "label": "Controle", "icon": "mail-check",
          "items": [
            { "type": "stack", "items": [
              { "type": "small", "cmd": "deliveryReceipt", "keepLabel": true },
              { "type": "small", "cmd": "returnReceipt", "keepLabel": true }
            ] }
          ]
        }
      ]
    },
    {
      "id": "inserir",
      "label": "Inserir",
      "collapseOrder": ["symbols", "text", "links", "illustrations", "tables", "insertInclude"],
      "groups": [
        {
          "id": "insertInclude", "label": "Incluir", "icon": "paperclip",
          "items": [
