        { "keys": "Ctrl+Alt+1", "cmd": "style", "args": { "value": "h1" }, "scope": "body", "typingWins": true, "note": "Onde Ctrl+Alt+1/2/3 digita um caractere (¹ ² ³ no ABNT2, ¡ ² ³ no US-Internacional), o caractere vence" },
        { "keys": "Ctrl+Alt+2", "cmd": "style", "args": { "value": "h2" }, "scope": "body", "typingWins": true },
