    "redo": { "label": "Refazer", "icon": "redo-2", "enabled": "canRedo", "tbKeys": ["Ctrl+Y"], "tip": "Refaz a última ação desfeita." },
    "send": { "label": "Enviar", "icon": "send-horizontal", "tbKeys": ["Ctrl+Enter"], "tip": "Envia a mensagem." },
