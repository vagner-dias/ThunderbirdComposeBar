{
  "version": 1,
  "comment": "Definição declarativa da Faixa de Opções: registro de comandos, abas, perfis de atalho, paletas e estilos. Rótulos em pt-BR; as traduções ficam em ribbon/locales/<idioma>.json.",

  "commands": {
    "paste": { "label": "Colar", "icon": "clipboard-paste", "native": "cmd_paste", "tbKeys": ["Ctrl+V"], "tip": "Adiciona o conteúdo da Área de Transferência ao documento." },
    "pasteNoFormatting": { "label": "Colar sem Formatação", "icon": "type", "native": "cmd_pasteNoFormatting", "focus": "editor", "enabled": "html", "tbKeys": ["Ctrl+Shift+V"], "tip": "Cola somente o texto, sem a formatação de origem." },
    "pasteQuote": { "label": "Colar como Citação", "icon": "reply", "native": "cmd_pasteQuote", "focus": "editor", "tbKeys": ["Ctrl+Shift+O"], "tip": "Cola o conteúdo como texto citado." },
    "cut": { "label": "Recortar", "icon": "scissors", "native": "cmd_cut", "enabled": "selection", "tbKeys": ["Ctrl+X"], "tip": "Remove a seleção e a coloca na Área de Transferência." },
    "copy": { "label": "Copiar", "icon": "copy", "native": "cmd_copy", "enabled": "selection", "tbKeys": ["Ctrl+C"], "tip": "Coloca uma cópia da seleção na Área de Transferência." },
    "painter": { "label": "Pincel de Formatação", "icon": "paintbrush", "enabled": "html", "pressed": "painter", "tip": "Copia a formatação do trecho selecionado para aplicar em outro. Clique duas vezes para aplicar em vários lugares; Esc encerra. Pelo teclado: Ctrl+Alt+C copia e Ctrl+Alt+V aplica." },
    "painterCopy": { "label": "Copiar Formatação", "enabled": "html", "hidden": true },
    "painterApply": { "label": "Colar Formatação", "enabled": "html", "hidden": true },

    "fontName": { "label": "Fonte", "type": "fontCombo", "enabled": "html", "tip": "Escolha uma nova fonte para o texto." },
    "fontSize": { "label": "Tamanho da Fonte", "type": "sizeCombo", "enabled": "html", "tip": "Altere o tamanho do texto, em pontos." },
    "growFont": { "label": "Aumentar Tamanho da Fonte", "icon": "a-arrow-up", "enabled": "html", "tip": "Aumenta o tamanho do texto para o próximo tamanho da lista." },
    "shrinkFont": { "label": "Diminuir Tamanho da Fonte", "icon": "a-arrow-down", "enabled": "html", "tip": "Diminui o tamanho do texto para o tamanho anterior da lista." },
    "changeCase": { "label": "Maiúsculas e Minúsculas", "icon": "case-sensitive", "tip": "Altera o texto selecionado para maiúsculas, minúsculas ou outros usos comuns. Com o cursor numa palavra, vale para a palavra inteira.", "menu": "changeCase", "enabled": "html" },
    "clearFormatting": { "label": "Limpar Toda a Formatação", "icon": "remove-formatting", "enabled": "html", "tip": "Remove toda a formatação da seleção e volta o parágrafo ao estilo Normal." },

    "bold": { "label": "Negrito", "icon": "bold", "enabled": "html", "pressed": "bold", "tip": "Aplica negrito ao texto. Com o cursor numa palavra, vale para a palavra inteira." },
    "italic": { "label": "Itálico", "icon": "italic", "enabled": "html", "pressed": "italic", "tip": "Aplica itálico ao texto." },
    "underline": { "label": "Sublinhado", "icon": "underline", "enabled": "html", "pressed": "underline", "tip": "Sublinha o texto." },
    "strikethrough": { "label": "Tachado", "icon": "strikethrough", "enabled": "html", "pressed": "strike", "tip": "Risca o texto com uma linha no meio." },
    "subscript": { "label": "Subscrito", "icon": "subscript", "enabled": "html", "pressed": "sub", "tip": "Digita letras bem pequenas abaixo da linha de texto." },
    "superscript": { "label": "Sobrescrito", "icon": "superscript", "enabled": "html", "pressed": "sup", "tip": "Digita letras bem pequenas acima da linha de texto." },
    "hilite": { "label": "Cor do Realce do Texto", "icon": "highlighter", "type": "color", "palette": "highlight", "default": "#FFFF00", "enabled": "html", "tip": "Realça o texto com uma cor, como um marca-texto." },
    "foreColor": { "label": "Cor da Fonte", "icon": "baseline", "type": "color", "palette": "font", "default": "#C00000", "enabled": "html", "tip": "Altera a cor do texto." },

    "bullets": { "label": "Marcadores", "icon": "list", "enabled": "html", "pressed": { "list": "ul" }, "menu": "bulletLibrary", "tip": "Cria uma lista com marcadores." },
    "numbering": { "label": "Numeração", "icon": "list-ordered", "enabled": "html", "pressed": { "list": "ol" }, "menu": "numberLibrary", "tip": "Cria uma lista numerada." },
    "multilevel": { "label": "Lista de Vários Níveis", "icon": "list-tree", "phase": 2, "tip": "Organiza itens em vários níveis (1. → a. → i.)." },
    "outdent": { "label": "Diminuir Recuo", "icon": "list-indent-decrease", "enabled": "html", "tip": "Aproxima o parágrafo da margem." },
    "indent": { "label": "Aumentar Recuo", "icon": "list-indent-increase", "enabled": "html", "tip": "Afasta o parágrafo da margem." },
    "sort": { "label": "Classificar", "icon": "arrow-down-a-z", "phase": 2, "tip": "Coloca parágrafos ou itens em ordem alfabética." },
    "showMarks": { "label": "Mostrar Tudo", "icon": "pilcrow", "enabled": "html", "pressed": "marks", "tip": "Mostra as marcas de parágrafo. As marcas não vão na mensagem.", "anyFocus": true },
    "alignLeft": { "label": "Alinhar à Esquerda", "icon": "text-align-start", "enabled": "html", "pressed": { "align": "left" }, "tip": "Alinha o conteúdo à margem esquerda." },
    "alignCenter": { "label": "Centralizar", "icon": "text-align-center", "enabled": "html", "pressed": { "align": "center" }, "tip": "Centraliza o conteúdo na página." },
    "alignRight": { "label": "Alinhar à Direita", "icon": "text-align-end", "enabled": "html", "pressed": { "align": "right" }, "tip": "Alinha o conteúdo à margem direita." },
    "alignJustify": { "label": "Justificar", "icon": "text-align-justify", "enabled": "html", "pressed": { "align": "justify" }, "tip": "Distribui o texto igualmente entre as margens." },
    "lineSpacing": { "label": "Espaçamento de Linha e Parágrafo", "icon": "spacing", "type": "menu", "menu": "lineSpacing", "enabled": "html", "tip": "Escolhe o espaço entre as linhas do parágrafo." },
    "shading": { "label": "Sombreamento", "icon": "paint-bucket", "phase": 2, "tip": "Colore o fundo do parágrafo." },
    "borders": { "label": "Bordas", "icon": "square-dashed", "phase": 2, "tip": "Adiciona bordas ao parágrafo." },

    "styles": { "label": "Estilos", "type": "gallery", "enabled": "html", "tip": "Aplica um estilo ao parágrafo." },
    "style": { "label": "Estilo", "enabled": "html", "hidden": true },
    "changeStyles": { "label": "Alterar Estilos", "icon": "swatch-book", "phase": 2, "tip": "Troca o conjunto de estilos, cores e fontes do tema." },

    "find": { "label": "Localizar", "icon": "search", "native": "cmd_find", "focus": "editor", "tbKeys": ["Ctrl+F"], "tip": "Localiza texto na mensagem." },
    "replace": { "label": "Substituir", "icon": "replace", "native": "cmd_findReplace", "focus": "editor", "enabled": "editor", "tbKeys": ["Ctrl+H"], "tip": "Pesquisa e substitui texto na mensagem." },
    "select": { "label": "Selecionar", "icon": "text-select", "type": "menu", "menu": "select", "tip": "Seleciona texto na mensagem." },
    "selectAll": { "label": "Selecionar Tudo", "native": "cmd_selectAll", "focus": "editor", "tbKeys": ["Ctrl+A"], "hidden": true },
    "selectSimilar": { "label": "Selecionar Texto com Formatação Semelhante", "phase": 2, "hidden": true },
    "zoom": { "label": "Zoom", "icon": "zoom-in", "type": "menu", "menu": "zoom", "tip": "Aumenta ou diminui a exibição da mensagem. Não altera o que é enviado." },

    "addressBook": { "label": "Catálogo de Endereços", "icon": "book-user", "tip": "Escolhe destinatários para Para, Cc e Cco nos catálogos de endereços. O F9 mostra os contatos ao lado da mensagem." },
    "checkNames": { "label": "Verificar Nomes", "icon": "user-check", "tip": "Confere nos catálogos de endereços os nomes digitados em Para, Cc e Cco. No Para, o atalho é Ctrl+K." },
    "attachFile": { "label": "Anexar Arquivo", "icon": "paperclip", "native": "cmd_attachFile", "tip": "Anexa arquivos do computador, pelo Filelink, uma página da web ou o seu cartão de visita.", "menu": "attach" },
    "insertLink": { "label": "Link", "icon": "link", "native": "cmd_link", "focus": "editor", "enabled": "html", "tbKeys": ["Ctrl+K"], "tip": "Cria um link no texto selecionado." },
    "insertImage": { "label": "Imagem", "icon": "image", "native": "cmd_image", "focus": "editor", "enabled": "html", "tip": "Insere uma imagem no corpo da mensagem." },
    "signature": { "label": "Assinatura", "icon": "signature", "menu": "signature", "enabled": "htmlEditor", "tip": "Insere uma das suas assinaturas. Em Assinaturas… você cria as assinaturas e escolhe a padrão de cada conta, para mensagens novas e para respostas e encaminhamentos." },
    "insertSignature": { "label": "Inserir Assinatura", "icon": "signature", "enabled": "htmlEditor", "hidden": true },
    "signatureOptions": { "label": "Assinaturas…", "icon": "settings", "hidden": true },
    "followUp": { "label": "Acompanha\u00admento", "icon": "flag", "pressed": "followUp", "tip": "Sinaliza a mensagem para acompanhamento: depois do envio, a cópia em Enviados fica com estrela, para você lembrar de cobrar a resposta. No menu, também para os destinatários." },
    "followUpMe": { "label": "Sinalizar para Mim", "icon": "flag", "hidden": true },
    "followUpRecipients": { "label": "Sinalizar para os Destinatários", "icon": "users", "hidden": true },
    "followUpClear": { "label": "Limpar Sinalizador", "icon": "x", "hidden": true },
    "deliveryReceipt": { "label": "Solicitar Confirmação de Entrega", "shortLabel": "Confirmação de Entrega", "icon": "mail-check", "pressed": "dsn", "tip": "Pede ao servidor de e-mail de quem recebe um aviso de que a mensagem foi entregue (notificação de status de entrega). Nem todo servidor manda o aviso." },
    "returnReceipt": { "label": "Solicitar Confirmação de Leitura", "shortLabel": "Confirmação de Leitura", "icon": "mail-open", "pressed": "returnReceipt", "tip": "Pede a quem recebe que confirme quando abrir a mensagem. A pessoa pode recusar, e alguns programas de e-mail não respondem." },
    "priorityHigh": { "label": "Alta Prioridade", "icon": "exclaim", "target": "background", "pressed": { "priority": "highest" }, "tip": "Marca a mensagem como de alta prioridade (X-Priority 1)." },
    "priorityLow": { "label": "Baixa Prioridade", "icon": "arrow-down", "target": "background", "pressed": { "priority": "lowest" }, "tip": "Marca a mensagem como de baixa prioridade (X-Priority 5)." },

    "formatHTML": { "label": "HTML", "icon": "code-xml", "target": "background", "enabled": "htmlEditor", "pressed": { "deliveryFormat": ["auto", "html", "both"] }, "tip": "Envia a mensagem em HTML, com uma versão em texto para quem não lê HTML." },
    "formatPlain": { "label": "Texto sem Formatação", "icon": "type", "target": "background", "enabled": "htmlEditor", "pressed": { "deliveryFormat": "plaintext" }, "tip": "Envia só texto, sem formatação, como no Outlook: a formatação sai do texto (um Ctrl+Z traz de volta) e os comandos de formatação ficam desativados." },

    "attachMessage": { "label": "Anexar Mensagem", "icon": "mails", "tip": "Anexa mensagens do Thunderbird a esta, como arquivos .eml (o Item do Outlook)." },
    "businessCard": { "label": "Cartão de Visita", "icon": "contact", "menu": "businessCard", "tip": "Anexa o seu cartão de visita (vCard) ou o de um contato dos catálogos de endereços." },
    "otherBusinessCards": { "label": "Outros Cartões de Visita…", "icon": "contact", "hidden": true },
    "table": { "label": "Tabela", "icon": "table", "menu": "table", "enabled": "html", "tip": "Insere uma tabela: escolha na grade quantas colunas e linhas. Com o cursor numa tabela, o menu também insere e exclui linhas e colunas." },
    "insertTable": { "label": "Inserir Tabela", "enabled": "html", "hidden": true },
    "insertTableDialog": { "label": "Inserir Tabela…", "icon": "table-2", "native": "cmd_InsertTable", "focus": "editor", "enabled": "html", "hidden": true },
    "tableRowAbove": { "label": "Inserir Linhas Acima", "icon": "between-horizontal-start", "native": "cmd_InsertRowAbove", "focus": "editor", "enabled": "inCell", "hidden": true },
    "tableRowBelow": { "label": "Inserir Linhas Abaixo", "icon": "between-horizontal-end", "native": "cmd_InsertRowBelow", "focus": "editor", "enabled": "inCell", "hidden": true },
    "tableColBefore": { "label": "Inserir Colunas à Esquerda", "icon": "between-vertical-start", "native": "cmd_InsertColumnBefore", "focus": "editor", "enabled": "inCell", "hidden": true },
    "tableColAfter": { "label": "Inserir Colunas à Direita", "icon": "between-vertical-end", "native": "cmd_InsertColumnAfter", "focus": "editor", "enabled": "inCell", "hidden": true },
    "tableDeleteRow": { "label": "Excluir Linhas", "icon": "rows-3", "native": "cmd_DeleteRow", "focus": "editor", "enabled": "inCell", "hidden": true },
    "tableDeleteCol": { "label": "Excluir Colunas", "icon": "columns-3", "native": "cmd_DeleteColumn", "focus": "editor", "enabled": "inCell", "hidden": true },
    "tableDelete": { "label": "Excluir Tabela", "icon": "trash", "native": "cmd_DeleteTable", "focus": "editor", "enabled": "inTable", "hidden": true },
    "tableMerge": { "label": "Mesclar Células", "icon": "table-cells-merge", "native": "cmd_JoinTableCells", "focus": "editor", "enabled": "inCell", "hidden": true },
    "tableSplit": { "label": "Dividir Células", "icon": "table-cells-split", "native": "cmd_SplitTableCell", "focus": "editor", "enabled": "inCell", "hidden": true },
    "tableProperties": { "label": "Propriedades da Tabela…", "icon": "table-properties", "native": "cmd_editTable", "focus": "editor", "enabled": "inTable", "hidden": true },
    "pictures": { "label": "Imagens", "icon": "images", "native": "cmd_image", "focus": "editor", "enabled": "html", "tip": "Insere uma imagem do computador ou da web no corpo da mensagem." },
    "bookmark": { "label": "Indicador", "icon": "bookmark", "native": "cmd_anchor", "focus": "editor", "enabled": "html", "tip": "Marca um ponto da mensagem com um nome (âncora), para um link levar até ele." },
    "quickParts": { "label": "Partes Rápidas", "icon": "blocks", "menu": "quickParts", "enabled": "text", "tip": "Insere trechos prontos, os seus e os da sua organização. Selecione um texto e salve-o como Parte Rápida para usar de novo." },
    "insertQuickPart": { "label": "Inserir Parte Rápida", "enabled": "text", "hidden": true },
    "saveQuickPart": { "label": "Salvar Seleção na Galeria de Partes Rápidas…", "icon": "square-plus", "enabled": "selectionBody", "hidden": true },
    "quickPartsOptions": { "label": "Partes Rápidas…", "icon": "settings", "hidden": true },
    "dateTime": { "label": "Data e Hora", "icon": "calendar-clock", "enabled": "text", "tip": "Insere a data ou a hora de agora, no formato que você escolher." },
    "emoji": { "label": "Emoji", "icon": "smile", "menu": "emoji", "enabled": "text", "tip": "Insere um emoji no texto." },
    "insertEmoji": { "label": "Inserir Emoji", "enabled": "text", "hidden": true },
    "symbol": { "label": "Símbolo", "icon": "omega", "menu": "symbol", "enabled": "text", "tip": "Insere símbolos que não estão no teclado, como os de direitos autorais, marca registrada, moedas e letras gregas." },
    "insertSymbol": { "label": "Inserir Símbolo", "enabled": "text", "hidden": true },
    "moreSymbols": { "label": "Mais Símbolos…", "icon": "omega", "native": "cmd_insertChars", "focus": "editor", "enabled": "text", "hidden": true },
    "hline": { "label": "Linha Horizontal", "icon": "separator-horizontal", "native": "cmd_hline", "focus": "editor", "enabled": "html", "tip": "Insere uma linha horizontal no ponto do cursor." },

    "help": { "label": "Ajuda", "icon": "circle-help", "tip": "Abre a ajuda da Faixa de Opções: o que cada aba faz, assinaturas, partes rápidas e teclado. A sua organização pode trocar pela ajuda dela." },
    "contactSupport": { "label": "Contatar o Suporte", "icon": "headset", "enabled": "support", "tip": "Mostra como falar com o suporte da sua organização: e-mail, telefone e portal." },
    "keyboardShortcuts": { "label": "Atalhos de Teclado", "icon": "keyboard", "tip": "Mostra o que cada atalho do Office faz aqui, no perfil de atalhos escolhido, e testa as teclas." },
